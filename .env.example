# Copy to .env for the Node server. Keep real credentials out of Git and chat.
# Blank service settings leave those capabilities disabled.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
DATABASE_PATH=data/pocket.sqlite
TZ=Asia/Shanghai
SERVE_STATIC=false
BASE_PATH=
TRUST_PROXY=false
APP_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3001,http://127.0.0.1:5173,http://127.0.0.1:4173,https://xiaoming96.github.io
PUBLIC_APP_URL=
PUBLIC_SITE_URL=
AUTH_SECRET=
ADMIN_USER_IDS=
REPAIR_PRICE_CENTS=100
MAX_IMAGE_REQUESTS_PER_DAY=5
MAX_MEMBER_IMAGE_REQUESTS_PER_DAY=20

# Compose host port; the container always listens on port 3001.
POCKET_API_PORT=3001

# Public frontend build values. These must never contain credentials.
# Pages workflow supplies /baibaodai/ for VITE_BASE_PATH.
VITE_BASE_PATH=/
VITE_API_BASE_URL=

# Operator-owned SMS adapter. Not a built-in Twilio/Aliyun integration.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# Real WeChat app credentials and approved HTTPS callback URI.
# WECHAT_LOGIN_MODE=qr for website QR login; blank for in-WeChat OAuth.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
WECHAT_LOGIN_MODE=

# Chat Completions-compatible text API. Blank URL uses the documented default.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Image gateway must return HTTPS URLs. All three settings are required.
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# Operator-owned checkout adapter and matching signed-webhook secret.
PAY_GATEWAY_URL=
PAY_GATEWAY_TOKEN=
PAY_WEBHOOK_SECRET=

# Operator-owned manufacturing/shipping adapter.
FULFILLMENT_URL=
FULFILLMENT_TOKEN=
